# Copy to `.env` (never commit `.env`).
# Values below are for local development only.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=income_expenses
# Change if port 5432 is already used by a locally installed PostgreSQL.
POSTGRES_PORT=5432

# --- API ---
# Used by Prisma CLI and the API when running on the host machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/income_expenses
# Used by integration tests (Phase 4+).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/income_expenses_test

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Browser origins allowed by CORS (comma-separated). Empty in production (same origin).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API: 0 locally, 2 in production (host nginx + web nginx).
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=300

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
LOGIN_RATE_LIMIT_PER_MINUTE=5
