# Copy to /opt/income-expenses/<env>/.env on the server and `chmod 600 .env`.
# Never commit the real file.

# production | staging — must differ so both stacks can run on one server
COMPOSE_PROJECT_NAME=income-expenses-production
# 8080 for production, 8081 for staging (host nginx proxies to 127.0.0.1:<port>)
WEB_PORT=8080

# Image source: ghcr.io/<GHCR_OWNER>/income-expenses-{api,web,migrate}:<IMAGE_TAG>
GHCR_OWNER=your-github-username
# Git SHA of the release; the deploy workflow rewrites this line on every deploy.
IMAGE_TAG=latest

# Database — use a long random password WITHOUT URL-special characters (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_USER=income_expenses
POSTGRES_PASSWORD=change-me-hex-only
POSTGRES_DB=income_expenses

# At least 32 random characters:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me

LOG_LEVEL=info
