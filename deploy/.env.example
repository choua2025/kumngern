# Copy to /opt/income-expenses/<env>/.env on the server and `chmod 600 .env`.
# Never commit the real file.

# production | staging — must differ so both stacks can run on one server
COMPOSE_PROJECT_NAME=income-expenses-staging
# 8080 for production, 8081 for staging (host nginx proxies to 127.0.0.1:<port>)
WEB_PORT=8081

# Public domains (host nginx + Certbot). deploy.sh health-checks these over HTTPS.
APP_DOMAIN=front.dev.chdev.site
API_DOMAIN=api.dev.chdev.site

# Image source: ghcr.io/<GHCR_OWNER>/income-expenses-{api,migrate,web}:<tag>
GHCR_OWNER=choua2025
# Git SHAs of the running releases — deploy.sh rewrites these; api and web move independently.
API_IMAGE_TAG=staging
WEB_IMAGE_TAG=staging

# Database — use a long random password WITHOUT URL-special characters (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_USER=income_expenses
POSTGRES_PASSWORD=change-me-hex-only
POSTGRES_DB=income_expenses

# At least 32 random characters:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me

LOG_LEVEL=info

# Recurring transactions job, daily at 00:05 in CRON_TZ
CRON_ENABLED=true
CRON_TZ=Asia/Bangkok

# Optional: heartbeat URL pinged by check.sh when everything is fine (Better Stack /
# healthchecks.io "heartbeat" check). No pings for a while → you get an alert.
HEARTBEAT_URL=

# Forgot password: HMAC key for reset codes —  openssl rand -base64 48
PASSWORD_RESET_SECRET=change-me
# Email via Brevo SMTP (Brevo → SMTP & API → SMTP). Empty SMTP_HOST = no email, and
# "forgot password" answers 503 until it is set. The sender domain must be verified in
# Brevo (SPF + DKIM records in the chdev.site DNS) or mail lands in spam.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Income & Expenses <noreply@chdev.site>
