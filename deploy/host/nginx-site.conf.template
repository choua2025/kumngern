# Host nginx for ONE environment of Income & Expenses (rendered by setup-host.sh).
#   ${APP_DOMAIN} → the whole app (SPA + /api, same origin)
#   ${API_DOMAIN} → the API only (/api/*), e.g. for tools and health monitors
# Both go to the web container on 127.0.0.1:${WEB_PORT}; its nginx forwards /api to the
# api container. Hops: host nginx → web nginx → api, hence TRUST_PROXY=2 in compose.
# Certbot adds the "listen 443 ssl" lines and the HTTP → HTTPS redirect to this file.

upstream income_expenses_${ENV_NAME} {
    server 127.0.0.1:${WEB_PORT};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};

    # Attachments: 3 files × 5 MB in one request. The default (1m) would answer 413.
    client_max_body_size 20m;

    location / {
        proxy_pass http://income_expenses_${ENV_NAME};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://income_expenses_${ENV_NAME};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # This hostname serves the API only — the SPA lives on ${APP_DOMAIN}.
    location / {
        return 404;
    }
}
