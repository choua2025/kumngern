{
  "name": "@income-expenses/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:coverage": "vitest run --coverage",
    "reconcile": "tsx --conditions=development scripts/reconcile-reports.ts",
    "db:seed-reference": "tsx prisma/seed-reference.ts",
    "db:release": "prisma migrate deploy && tsx prisma/seed-reference.ts",
    "job:recurring": "tsx --conditions=development src/jobs/run-recurring.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@income-expenses/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.15",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  }
}
