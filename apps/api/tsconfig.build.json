{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Production build resolves @income-expenses/shared to its compiled dist/,
    // not to its TypeScript source (build packages/shared first).
    "customConditions": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test"]
}
