{
  "name": "income-expenses",
  "version": "0.1.0",
  "private": true,
  "description": "Personal income & expense tracker with multi-wallet balances and monthly budgets",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @income-expenses/api",
    "dev:web": "npm run dev -w @income-expenses/web",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @income-expenses/api",
    "db:deploy": "npm run db:deploy -w @income-expenses/api",
    "db:reset": "npm run db:reset -w @income-expenses/api",
    "db:seed": "npm run db:seed -w @income-expenses/api",
    "db:studio": "npm run db:studio -w @income-expenses/api",
    "db:psql": "docker compose exec db psql",
    "db:check": "docker compose exec -T db psql < apps/api/prisma/sql/check-view.sql",
    "db:summary": "docker compose exec -T db psql < apps/api/prisma/sql/seed-summary.sql"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
